<div class="lk-sync-manager">
  <!-- Connection Header -->
  <header class="lk-sync-header-bar">
    <div class="lk-connection-info">
      {{#if connection.ok}}
        <span class="lk-status-dot lk-dot-connected" title="Connected to LegendKeeper API"></span>
        <div class="lk-project-details">
          <strong>{{connection.project.name}}</strong>
          <span class="lk-project-id">({{connection.project.id}}) • v{{moduleVersion}}</span>
        </div>
      {{else}}
        <span class="lk-status-dot lk-dot-error" title="Not Connected to LegendKeeper API"></span>
        <div class="lk-project-details">
          <strong>Not Connected (v{{moduleVersion}})</strong>
          {{#if connection.error}}
            <span class="lk-error-text">{{connection.error}}</span>
          {{/if}}
        </div>
      {{/if}}
    </div>

    <div class="lk-header-actions">
      <button
        type="button"
        class="lk-btn"
        data-action="test-connection"
        title="Verify your LegendKeeper API key and CORS proxy connection"
        {{#if isBusy}}disabled{{/if}}
      >
        <i class="fas fa-plug"></i> Test Connection
      </button>
      <button
        type="button"
        class="lk-btn"
        data-action="refresh"
        title="Re-fetch LegendKeeper resources and recalculate sync status for all Foundry journals"
        {{#if isBusy}}disabled{{/if}}
      >
        <i class="fas fa-sync-alt {{#if isLoading}}fa-spin{{/if}}"></i> Refresh
      </button>
      <button
        type="button"
        class="lk-btn"
        data-action="open-settings"
        title="Open Foundry Module Settings to configure API Key, CORS Proxy, Folder Name, and Conflict Policy"
      >
        <i class="fas fa-cog"></i> Settings
      </button>
    </div>
  </header>

  <!-- Summary Status Cards -->
  <section class="lk-summary-cards">
    <div
      class="lk-card {{#if (eq statusFilter 'all')}}active{{/if}}"
      data-action="filter-status"
      data-status="all"
      title="Show all LegendKeeper resources and local Foundry journals"
    >
      <span class="lk-card-value">{{counts.total}}</span>
      <span class="lk-card-label">Total</span>
    </div>
    <div
      class="lk-card lk-card-insync {{#if (eq statusFilter 'in-sync')}}active{{/if}}"
      data-action="filter-status"
      data-status="in-sync"
      title="Filter: Resources whose Foundry Journal and LegendKeeper article match the last sync"
    >
      <span class="lk-card-value">{{counts.inSync}}</span>
      <span class="lk-card-label">In Sync</span>
    </div>
    <div
      class="lk-card lk-card-remote {{#if (eq statusFilter 'remote-only')}}active{{/if}}"
      data-action="filter-status"
      data-status="remote-only"
      title="Filter: Resources in LegendKeeper that have not been pulled into Foundry yet"
    >
      <span class="lk-card-value">{{counts.remoteOnly}}</span>
      <span class="lk-card-label">In LK Only</span>
    </div>
    <div
      class="lk-card lk-card-remotenewer {{#if (eq statusFilter 'remote-newer')}}active{{/if}}"
      data-action="filter-status"
      data-status="remote-newer"
      title="Filter: Resources modified in LegendKeeper since the last sync"
    >
      <span class="lk-card-value">{{counts.remoteNewer}}</span>
      <span class="lk-card-label">LK Newer</span>
    </div>
    <div
      class="lk-card lk-card-local {{#if (eq statusFilter 'local-only')}}active{{/if}}"
      data-action="filter-status"
      data-status="local-only"
      title="Filter: Local Foundry Journals that are not linked to a LegendKeeper resource"
    >
      <span class="lk-card-value">{{counts.localOnly}}</span>
      <span class="lk-card-label">Foundry Only</span>
    </div>
    <div
      class="lk-card lk-card-localnewer {{#if (eq statusFilter 'local-newer')}}active{{/if}}"
      data-action="filter-status"
      data-status="local-newer"
      title="Filter: Linked Foundry Journals modified locally since the last sync"
    >
      <span class="lk-card-value">{{counts.localNewer}}</span>
      <span class="lk-card-label">Foundry Newer</span>
    </div>
    <div
      class="lk-card lk-card-conflict {{#if (eq statusFilter 'conflict')}}active{{/if}}"
      data-action="filter-status"
      data-status="conflict"
      title="Filter: Resources modified in BOTH Foundry and LegendKeeper since the last sync"
    >
      <span class="lk-card-value">{{counts.conflict}}</span>
      <span class="lk-card-label">Conflicts</span>
    </div>
  </section>

  <!-- Bulk Sync & Filter Toolbar -->
  <section class="lk-toolbar">
    <div class="lk-bulk-buttons">
      <button
        type="button"
        class="lk-btn lk-btn-primary"
        data-action="pull-all"
        title="Download all LegendKeeper resources into the top-level LegendKeeper folder, set player Observer permissions on visible articles, and update the '📖 LegendKeeper Wiki Index' journal"
        {{#if isBusy}}disabled{{/if}}
      >
        <i class="fas fa-cloud-download-alt"></i> Pull All from LK
      </button>
      <button
        type="button"
        class="lk-btn lk-btn-accent"
        data-action="push-linked"
        title="Checks LegendKeeper for remote edits first, prompts on any same-page conflicts, and pushes modified linked Foundry journals to LegendKeeper"
        {{#if isBusy}}disabled{{/if}}
      >
        <i class="fas fa-cloud-upload-alt"></i> Push Modified to LK
      </button>
      <button
        type="button"
        class="lk-btn"
        data-action="push-all"
        title="Pushes all modified linked journals AND creates new LegendKeeper resources for any unlinked local Foundry journals"
        {{#if isBusy}}disabled{{/if}}
      >
        <i class="fas fa-upload"></i> Push All (Incl. Unlinked)
      </button>
    </div>

    <div class="lk-filter-controls">
      <input
        type="search"
        class="lk-search-input"
        placeholder="Search journals, parents, or tags..."
        title="Filter items by resource title, parent folder path, or tag"
        value="{{searchQuery}}"
      />
      <select class="lk-status-select" title="Filter displayed items by synchronization status">
        <option value="all" {{#if (eq statusFilter "all")}}selected{{/if}}>All Statuses</option>
        <option value="needs-action" {{#if (eq statusFilter "needs-action")}}selected{{/if}}>Needs Sync Action</option>
        <option value="in-sync" {{#if (eq statusFilter "in-sync")}}selected{{/if}}>In Sync</option>
        <option value="remote-only" {{#if (eq statusFilter "remote-only")}}selected{{/if}}>In LK Only</option>
        <option value="remote-newer" {{#if (eq statusFilter "remote-newer")}}selected{{/if}}>LK Newer</option>
        <option value="local-only" {{#if (eq statusFilter "local-only")}}selected{{/if}}>In Foundry Only</option>
        <option value="local-newer" {{#if (eq statusFilter "local-newer")}}selected{{/if}}>Foundry Newer</option>
        <option value="conflict" {{#if (eq statusFilter "conflict")}}selected{{/if}}>Conflicts</option>
      </select>
    </div>
  </section>

  <!-- Live Progress Bar -->
  {{#if progress.active}}
    <section class="lk-progress-container">
      <div class="lk-progress-header">
        <span class="lk-progress-phase">{{progress.phase}}</span>
        <span class="lk-progress-percent">{{progress.percent}}%</span>
      </div>
      <div class="lk-progress-bar-track">
        <div class="lk-progress-bar-fill" style="width: {{progress.percent}}%;"></div>
      </div>
    </section>
  {{/if}}

  <!-- Sync Items Table -->
  <section class="lk-table-wrapper">
    <table class="lk-sync-table">
      <thead>
        <tr>
          <th title="LegendKeeper resource title (articles nested deeper than Foundry's 4-folder limit are prefixed with their remaining subfolder path in Foundry)">Resource / Journal</th>
          <th title="Full LegendKeeper ancestor hierarchy path">Parent / Folder</th>
          <th class="lk-col-center" title="Number of LegendKeeper document tabs / Foundry JournalEntry pages">Pages</th>
          <th class="lk-col-center" title="Current synchronization status between Foundry VTT and LegendKeeper">Status</th>
          <th class="lk-col-actions" title="Sync or open individual resources">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#if filteredItems.length}}
          {{#each filteredItems}}
            <tr class="lk-row lk-row-{{this.status}}">
              <td class="lk-cell-name">
                <div class="lk-entry-title" title="{{#if this.localName}}Foundry Journal: {{this.localName}}{{else}}{{this.name}}{{/if}}">{{this.name}}</div>
                {{#if this.tags.length}}
                  <div class="lk-entry-tags">
                    {{#each this.tags}}
                      <span class="lk-mini-tag">{{this}}</span>
                    {{/each}}
                  </div>
                {{/if}}
              </td>
              <td class="lk-cell-parent">
                {{#if this.parentName}}
                  <span class="lk-parent-label" title="LegendKeeper Parent Path: {{this.parentName}}"><i class="fas fa-folder-open"></i> {{this.parentName}}</span>
                {{else}}
                  <span class="lk-muted" title="Top-level resource">—</span>
                {{/if}}
              </td>
              <td class="lk-col-center">{{this.documentCount}}</td>
              <td class="lk-col-center">
                <span class="lk-badge lk-badge-{{this.status}}" title="{{this.statusLabel}}">{{this.statusLabel}}</span>
              </td>
              <td class="lk-col-actions">
                {{#if this.resourceId}}
                  <button
                    type="button"
                    class="lk-icon-btn"
                    data-action="pull-single"
                    data-resource-id="{{this.resourceId}}"
                    data-name="{{this.name}}"
                    title="Pull latest version of '{{this.name}}' from LegendKeeper into Foundry (prompts if a page has conflicting local and remote edits)"
                    {{#if ../isBusy}}disabled{{/if}}
                  >
                    <i class="fas fa-download"></i> Pull
                  </button>
                {{/if}}
                {{#if this.journalId}}
                  <button
                    type="button"
                    class="lk-icon-btn"
                    data-action="push-single"
                    data-journal-id="{{this.journalId}}"
                    data-resource-id="{{this.resourceId}}"
                    data-name="{{this.name}}"
                    title="Check LegendKeeper for remote edits first, then push '{{this.name}}' from Foundry to LegendKeeper"
                    {{#if ../isBusy}}disabled{{/if}}
                  >
                    <i class="fas fa-upload"></i> Push
                  </button>
                  <button
                    type="button"
                    class="lk-icon-btn"
                    data-action="open-journal"
                    data-journal-id="{{this.journalId}}"
                    data-page-id="{{this.pageId}}"
                    title="Open '{{this.name}}' in Foundry"
                  >
                    <i class="fas fa-book-open"></i>
                  </button>
                {{/if}}
                {{#if (and this.journalId this.resourceId)}}
                  <button
                    type="button"
                    class="lk-icon-btn lk-btn-danger"
                    data-action="unlink-journal"
                    data-journal-id="{{this.journalId}}"
                    data-resource-id="{{this.resourceId}}"
                    data-name="{{this.name}}"
                    title="Unlink '{{this.name}}' from LegendKeeper (keeps both the Foundry Journal/Page and LegendKeeper article, but stops syncing them together)"
                    {{#if ../isBusy}}disabled{{/if}}
                  >
                    <i class="fas fa-unlink"></i>
                  </button>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td colspan="5" class="lk-empty-row">
              {{#if isLoading}}
                <i class="fas fa-spinner fa-spin"></i> Loading LegendKeeper resources...
              {{else}}
                No matching resources or journals found.
              {{/if}}
            </td>
          </tr>
        {{/if}}
      </tbody>
    </table>
  </section>
</div>
